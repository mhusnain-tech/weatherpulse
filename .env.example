# WeatherPulse environment configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to source control.

# Required: Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional: ipinfo.io token for IP-based location detection
# Free tier (60 req/hr) works without a token.
# Get one at https://ipinfo.io/signup
IPINFO_TOKEN=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
